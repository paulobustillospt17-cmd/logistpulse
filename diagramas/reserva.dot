digraph G {
rankdir=LR; nodesep=0.35; ranksep=0.35; bgcolor="white"; node [fontname="Helvetica", fontsize=20, style=filled, fillcolor="#EEF3FB", color="#5B7DB1"]; edge [fontname="Helvetica-Bold", fontsize=22, color="#4A5A78"];
__i [shape=point, width=0.12, label=""];
"Solicitada" [shape=ellipse, fillcolor="#EEF3FB"];
"Validada" [shape=ellipse, fillcolor="#EEF3FB"];
"Reservada" [shape=ellipse, fillcolor="#EEF3FB"];
"Consumida" [shape=doublecircle, fillcolor="#E4F4E8"];
"Liberada" [shape=doublecircle, fillcolor="#EEF3FB"];
"Expirada" [shape=doublecircle, fillcolor="#EEF3FB"];
"Rechazada" [shape=doublecircle, fillcolor="#FBE9E9"];
__i -> "Solicitada";
"Solicitada" -> "Validada" [label="v: validar"];
"Solicitada" -> "Rechazada" [label="n: sin stock"];
"Validada" -> "Reservada" [label="c: confirmar"];
"Reservada" -> "Consumida" [label="p: picking (consumir)"];
"Reservada" -> "Liberada" [label="x: cancelar"];
"Reservada" -> "Expirada" [label="t: vence plazo"];
}